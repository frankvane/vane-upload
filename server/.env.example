# vane-upload server 配置样例（复制为 .env 后按需修改）
# 所有取值的默认值、合法性校验与启动自检见 server/src/config/index.js。
# 注意：本仓库不自动加载 .env，请由进程管理器 / 容器注入环境变量。

# ---- 运行环境 ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000

# ---- 鉴权（生产必须配置凭据，或替换 createAuthMiddleware）----
# demo = 关闭鉴权（仅本地开发）；其余值一律 fail-closed
# ⚠️ 部署基线（T-28）：下面这行 AUTH_MODE=demo 仅供本地开发。生产环境必须改为
#    secure 并配置凭据，同时设 NODE_ENV=production 才会执行启动期自检。
#    直接把本文件原样注入生产容器 = 所有 /api/file 接口无鉴权开放。
AUTH_MODE=demo
# FILE_AUTH_TOKEN=replace-with-a-long-random-token,second-token
# FILE_AUTH_COOKIE=session_id
# FILE_AUTH_COOKIE_TOKENS=replace-with-cookie-value
DEMO_USER_ID=test

# ---- 网络 ----
# 具体域名白名单，逗号分隔；生产禁止使用 *
# CORS_ORIGIN=https://upload.example.com
# 反向代理跳数（整数）；禁止使用 true / 留空后依赖伪造 XFF
# TRUST_PROXY_HOPS=1
RATE_LIMIT_ENABLED=true
# 0 = 不挂载限流器（不再是「静默改回 300」）
RATE_LIMIT_MAX=300

# ---- 请求体 / 分片 ----
# VU-09：JSON 体上限（MB），仅作用于已鉴权的 /api/file
JSON_BODY_LIMIT_MB=8
CHUNK_MAX_SIZE_MB=20

# ---- 容量与分片上限 ----
MAX_UPLOAD_SIZE_MB=5120
MAX_CHUNKS=100000
MAX_TOTAL_UPLOAD_SIZE_MB=20480
MAX_TOTAL_CHUNKS=200000
MAX_USER_UPLOAD_SIZE_MB=10240
MAX_USER_CHUNKS=100000

# ---- 文件类型策略（VU-33）----
# 留空 = 拒绝危险扩展名 / 危险 MIME；配置后只放行白名单 MIME
# ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf

# ---- 合并锁（VU-08）----
MERGE_WAIT_TIMEOUT_MS=30000
MERGE_MAX_WAITERS=64

# ---- 存储路径 ----
# SERVER_DATA_DIR=
# SERVER_TMP_UPLOAD_DIR=
# SERVER_UPLOADS_DIR=
# DB_STORAGE=
SQL_LOG=0

# ---- janitor / 落库队列 ----
TMP_TTL_HOURS=24
JANITOR_INTERVAL_HOURS=6
CHUNK_STATE_BATCH_SIZE=40
CHUNK_STATE_FLUSH_INTERVAL_MS=180
CHUNK_STATE_MAX_PENDING=120
