{
  "name": "vane-upload",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "files": [
    "dist/lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:demo && npm run build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --no-cache",
    "test:coverage": "vitest run --coverage --no-cache",
    "test:server:coverage": "npm run test:coverage -w server",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w server",
    "test:server": "npm test -w server",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:server:coverage && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spark-md5": "^3.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.7",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
