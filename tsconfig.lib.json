{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/lib",
    "rootDir": "src",
    "allowImportingTsExtensions": true
  },
  "include": ["src/index.ts", "src/vite-env.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**",
    "src/main.tsx",
    "src/App.tsx",
    "src/demo/**"
  ]
}
