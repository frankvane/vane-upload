{
  "name": "vane-upload-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/index.js\" --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "file-type": "^19.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
